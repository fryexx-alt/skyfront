function showRipple(latlng, color) {
    try {
        const pt = map.latLngToContainerPoint(latlng);
        const div = document.createElement('div');
        div.className = 'ripple';
        div.style.left = pt.x + 'px';
        div.style.top = pt.y + 'px';
        div.style.borderColor = color;
        mapContainer.appendChild(div);
        setTimeout(() => { try { div.remove(); } catch(e) {} }, 1700);
    } catch(e) {}
}

function showFloatingArea(latlng, text, color) {
    try {
        const pt = map.latLngToContainerPoint(latlng);
        const div = document.createElement('div');
        div.className = 'float-area';
        div.textContent = text;
        div.style.left = pt.x + 'px';
        div.style.top = pt.y + 'px';
        div.style.color = color;
        mapContainer.appendChild(div);
        setTimeout(() => { try { div.remove(); } catch(e) {} }, 2300);
    } catch(e) {}
}

function getFeatureCenter(feature) {
    try {
        const c = turf.centerOfMass(feature);
        const [lng, lat] = c.geometry.coordinates;
        return L.latLng(lat, lng);
    } catch(e) { return map.getCenter(); }
}

function animateValue(el, target, duration = 700) {
    const currentText = el.textContent.replace(/[^\d]/g, '');
    const start = parseInt(currentText) || 0;
    if (start === target) return;
    if (duration <= 0) { el.textContent = target.toLocaleString(currentLang === 'ua' ? 'uk-UA' : 'ru-RU'); return; }
    const startTime = performance.now();
    function frame(now) {
        const t2 = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - t2, 3);
        const cur = Math.round(start + (target - start) * eased);
        el.textContent = cur.toLocaleString(currentLang === 'ua' ? 'uk-UA' : 'ru-RU');
        if (t2 < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
}

function bumpElement(el) { el.classList.add('bump'); setTimeout(() => el.classList.remove('bump'), 700); }

// ============================================================
// 10. Snapshot
// ============================================================
function snapshotCurrentState() {
    snapshotLayer.clearLayers();
    drawnItems.eachLayer(gl => {
        if (!gl.eachLayer) return;
        gl.eachLayer(sub => {
            if (!sub.getLatLngs) return;
            try {
                const o = sub.options;
                const copy = L.polygon(sub.getLatLngs(), {
                    pane: 'snapshotPane', interactive: false,
                    className: 'zone-path',
                    color: o.color, fillColor: o.fillColor, fillOpacity: o.fillOpacity,
                    weight: o.weight, opacity: o.opacity, lineCap: 'round', lineJoin: 'round'
                }).addTo(snapshotLayer);
                if (copy._path && sub._mode) copy._path.setAttribute('data-mode', sub._mode);
            } catch(e) {}
        });
    });
}

// Останавливает текущую анимацию перехода и убирает все временные слои
function clearAllTempLayers() {
    stopAnimation();
    for (let i = activeTempLayers.length - 1; i >= 0; i--) {
        try { if (map.hasLayer(activeTempLayers[i])) map.removeLayer(activeTempLayers[i]); } catch(e) {}
    }
    activeTempLayers.length = 0;
    try { map.getPane('overlayPane').style.opacity = ''; } catch(e) {}
}

// ============================================================
// 11–12. Захват + буфер 2 км на линии контакта
// ============================================================
let animGeneration = 0;
const TRANSITION_MS = 1600;

// Чистая функция: применяет захват к истории и возвращает новую историю.
function applyCapture(hist, mode, features) {
    const enemy = mode === 'ru' ? 'ua' : 'ru';
    const A = features.length === 1 ? features[0] : (unionArray(features) || features[0]);

    // 1) захваченное вырезаем из территории противника и из старого буфера
    const kept = [];
    for (const h of hist) {
        if (h.mode === mode) { kept.push(h); continue; }
        const rest = subtractFeature(h.feature, A);
        if (rest) kept.push({ mode: h.mode, feature: rest, source: h.source });
    }

    // 2) новый буфер: полоса 2 км на территории противника вплотную к захвату
    let strip = null;
    try {
        const bufA = safeBuffer(A, BUFFER_WIDTH_KM);
        if (bufA) {
            const parts = [];
            for (const h of kept) {
                if (h.mode !== enemy) continue;
                const inter = intersectRobust(h.feature, bufA);
                if (inter && turf.area(inter) > 1000) parts.push(inter);
            }
            strip = filterSmallParts(unionArray(parts), 0.1);
        }
    } catch (e) { console.warn('buffer err', e); strip = null; }

    // 3) вычитаем буфер из территории противника — зоны не пересекаются
    const out = [];
    for (const h of kept) {
        if (strip && h.mode === enemy) {
            const r = subtractFeature(h.feature, strip);
            if (r) out.push({ mode: h.mode, feature: r, source: h.source });
        } else out.push(h);
    }
    features.forEach(f => out.push({ mode, feature: f, source: 'user' }));
    if (strip) out.push({ mode: 'buffer', feature: strip, source: 'auto' });
    return { history: out, strip, area: A };
}

function addCaptureBatch(mode, features) {
    if (!features || !features.length) return;
    const gen = ++animGeneration;
    clearAllTempLayers();

    let captureAreaKm2 = 0;
    features.forEach(f => { try { captureAreaKm2 += turf.area(f) / 1e6; } catch(e) {} });
    captureAreaKm2 = Math.round(captureAreaKm2);
    const captureCenter = getFeatureCenter(features[0]);

    snapshotCurrentState();

    undoStack.push({ history: history, log: captureLog });
    const res = applyCapture(history, mode, features);
    history = res.history;
    captureLog = captureLog.concat([{ mode, features }]);
    invalidateCache();

    redrawAll();
    setupZoneHovers();

    showRipple(captureCenter, COLORS[mode].fill);
    setTimeout(() => {
        if (animGeneration === gen) {
            showFloatingArea(captureCenter, `+${captureAreaKm2.toLocaleString('ru-RU')} км²`, COLORS[mode].glow);
        }
    }, 200);

    playBeep(mode === 'ru' ? 520 : 660, 0.18, 0.06);

    const pieces = features.map(f => ({ mode, feature: f }));
    if (res.strip) pieces.push({ mode: 'buffer', feature: res.strip });
    playTransition(mode, pieces);

    updateStats(true);
    let msg = `⚔️ ${t(mode)}: ${t('toasts.captured')}`;
    if (res.strip) msg += ` · 🛡️ ${t('toasts.bufferAuto')}`;
    showToast(msg);
}

// ============================================================
// 13. Волна перехода территории
// ------------------------------------------------------------
// Как это работает:
//  • снизу лежит снимок СТАРОЙ карты (snapshotPane), сверху — только НОВЫЕ куски (wavePane:
//    захваченная территория + буфер), настоящий слой карты на время анимации спрятан;
//  • из точки внутри захваченной области расходится круглая волна с мягким краем (радиальный
//    градиент): внутри волны старые цвета плавно растворяются, а новые проявляются;
//  • вдоль фронта волны бежит светящееся кольцо, обрезанное по форме захвата;
//  • в конце настоящий слой возвращается — цвета совпадают, поэтому шва не видно.
// ============================================================
const SVGNS = 'http://www.w3.org/2000/svg';
let activeAnim = null;

function svgEl(tag, attrs) {
    const e = document.createElementNS(SVGNS, tag);
    for (const k in (attrs || {})) e.setAttribute(k, attrs[k]);
    return e;
}

function stopAnimation() {
    if (activeAnim) { try { activeAnim.finish(); } catch (e) {} }
    activeAnim = null;
}

// контур фичи в координатах слоёв Leaflet (в них же рисуются все svg-панели)
function geoToPathD(feature) {
    const out = [];
    splitToPolygons(feature).forEach(poly => {
        const g = poly.geometry;
        if (!g || g.type !== 'Polygon') return;
        g.coordinates.forEach(ring => {
            let d = '';
            ring.forEach((c, i) => {
                const pt = map.latLngToLayerPoint([c[1], c[0]]);
                d += (i ? 'L' : 'M') + pt.x.toFixed(1) + ' ' + pt.y.toFixed(1);
            });
            out.push(d + 'Z');
        });
    });
    return out.join('');
}

function playTransition(mode, pieces) {
    stopAnimation();
    const live = (pieces || []).filter(p => p && p.feature);
    const snapPane = map.getPane('snapshotPane');
    const wavePane = map.getPane('wavePane');
    const overlayPane = map.getPane('overlayPane');

    const snapSvg = snapPane.querySelector('svg');
    let waveLayer = null, cleaned = false, rafId = 0;
    const nodes = [];       // svg-узлы, которые нужно убрать
    let snapG = null, waveG = null;

    const cleanup = () => {
        if (cleaned) return;
        cleaned = true;
        cancelAnimationFrame(rafId);
        try { map.off('zoomstart viewreset', onView); } catch (e) {}
        try { snapG && snapG.removeAttribute('mask'); } catch (e) {}
        try { waveG && waveG.removeAttribute('mask'); } catch (e) {}
        nodes.forEach(n => { try { n.parentNode && n.parentNode.removeChild(n); } catch (e) {} });
        try { waveLayer && map.removeLayer(waveLayer); } catch (e) {}
        try { snapshotLayer.clearLayers(); } catch (e) {}
        overlayPane.style.opacity = '';
        if (activeAnim === me) activeAnim = null;
    };
    const me = { finish: cleanup };
    const onView = () => cleanup();

    try {
        if (!live.length || !snapSvg) { cleanup(); return; }

        // 1) слой новых кусков
        waveLayer = L.featureGroup().addTo(map);
        live.forEach(p => {
            try {
                L.geoJSON(p.feature, { pane: 'wavePane', interactive: false, style: () => zoneStyle(p.mode, true) }).addTo(waveLayer);
            } catch (e) {}
        });
        const waveSvg = wavePane.querySelector('svg');
        if (!waveSvg) { cleanup(); return; }
        snapG = snapSvg.querySelector(':scope > g');
        waveG = waveSvg.querySelector(':scope > g');
        if (!snapG || !waveG) { cleanup(); return; }

        // 2) геометрия волны: центр — точка внутри захвата, радиус — до самой дальней вершины
        const dAll = live.map(p => geoToPathD(p.feature)).join('');
        let originLL;
        try {
            const pt = turf.pointOnFeature(live[0].feature);
            originLL = L.latLng(pt.geometry.coordinates[1], pt.geometry.coordinates[0]);
        } catch (e) { originLL = getFeatureCenter(live[0].feature); }
        const o = map.latLngToLayerPoint(originLL);
        let maxR = 10;
        live.forEach(p => {
            try {
                turf.coordAll(p.feature).forEach(c => {
                    const q = map.latLngToLayerPoint([c[1], c[0]]);
                    maxR = Math.max(maxR, Math.hypot(q.x - o.x, q.y - o.y));
                });
            } catch (e) {}
        });
        const FEATHER = 70;                                        // макс. ширина мягкого края, px
        const dur = Math.max(1400, Math.min(3200, 1000 + maxR * 1.8));

        // 3) svg: мягкая «волна» (маска с радиальным градиентом) для каждой панели
        const uid = Math.random().toString(36).slice(2, 8);
        const BIG = { maskUnits: 'userSpaceOnUse', x: -200000, y: -200000, width: 400000, height: 400000 };
        const defsOf = svg => {
            let d = svg.querySelector(':scope > defs');
            if (!d) { d = svgEl('defs'); svg.insertBefore(d, svg.firstChild); }
            return d;
        };
        const makeFeather = (svg, id) => {
            const defs = defsOf(svg);
            const grad = svgEl('radialGradient', { id: 'gr-' + id, gradientUnits: 'userSpaceOnUse', cx: o.x, cy: o.y, r: 1 });
            const stops = [[0, 1], [0.5, 1], [0.75, 0.45], [1, 0]].map(([off, a]) => {
                const st = svgEl('stop', { offset: off, 'stop-color': '#fff', 'stop-opacity': a });
                grad.appendChild(st); return st;
            });
            const circle = svgEl('circle', { cx: o.x, cy: o.y, r: 1, fill: 'url(#gr-' + id + ')' });
            const mask = svgEl('mask', Object.assign({ id: 'fm-' + id }, BIG));
            mask.appendChild(circle);
            defs.appendChild(grad); defs.appendChild(mask);
            nodes.push(grad, mask);
            return { grad, stops, circle, defs };
        };

        // старый снимок: виден везде, кроме области захвата, куда дошла волна
        const fo = makeFeather(snapSvg, 'o' + uid);
        const maskOld = svgEl('mask', Object.assign({ id: 'mo-' + uid }, BIG));
        maskOld.appendChild(svgEl('rect', { x: -200000, y: -200000, width: 400000, height: 400000, fill: '#fff' }));
        const holeG = svgEl('g', { mask: 'url(#fm-o' + uid + ')' });
        holeG.appendChild(svgEl('path', { d: dAll, fill: '#000', 'fill-rule': 'evenodd' }));
        maskOld.appendChild(holeG);
        fo.defs.appendChild(maskOld); nodes.push(maskOld);
        snapG.setAttribute('mask', 'url(#mo-' + uid + ')');

        // новые куски: видны только внутри волны
        const fn = makeFeather(waveSvg, 'n' + uid);
        waveG.setAttribute('mask', 'url(#fm-n' + uid + ')');

        // светящееся кольцо на фронте волны, обрезанное по форме захвата
        const maskRing = svgEl('mask', Object.assign({ id: 'mr-' + uid }, BIG));
        maskRing.appendChild(svgEl('path', { d: dAll, fill: '#fff', 'fill-rule': 'evenodd' }));
        fn.defs.appendChild(maskRing); nodes.push(maskRing);
        const glow = COLORS[mode].glow;
        const ringG = svgEl('g', { mask: 'url(#mr-' + uid + ')' });
        const ring = svgEl('circle', { cx: o.x, cy: o.y, r: 1, fill: 'none', stroke: glow, 'stroke-width': 4, 'stroke-opacity': 0.9 });
        ring.style.filter = 'drop-shadow(0 0 7px ' + glow + ')';
        ringG.appendChild(ring); waveSvg.appendChild(ringG); nodes.push(ringG);

        // 4) прячем настоящий слой на время анимации и запускаем волну
        overlayPane.style.transition = 'none';
        overlayPane.style.opacity = '0';
        map.on('zoomstart viewreset', onView);
        activeAnim = me;

        const setR = (f, r, fw) => {
            const rr = Math.max(r, 0.5), k = Math.min(1, fw / rr);
            f.circle.setAttribute('r', rr); f.grad.setAttribute('r', rr);
            f.stops[1].setAttribute('offset', (1 - k).toFixed(4));
            f.stops[2].setAttribute('offset', (1 - k * 0.5).toFixed(4));
        };
        const t0 = performance.now();
        const frame = now => {
            if (cleaned) return;
            const p = Math.min(1, (now - t0) / dur);
            const e = -(Math.cos(Math.PI * p) - 1) / 2;            // плавный старт и финиш
            const R = (maxR + FEATHER) * e;
            const fw = Math.min(FEATHER, 0.4 * R);
            setR(fo, R, fw); setR(fn, R, fw);
            ring.setAttribute('r', Math.max(0.5, R - fw * 0.55));
            ring.setAttribute('stroke-opacity', (0.95 * (1 - p * p)).toFixed(3));
            ring.setAttribute('stroke-width', (1.5 + 3 * (1 - p)).toFixed(2));
            if (p < 1) rafId = requestAnimationFrame(frame);
            else cleanup();
        };
        setR(fo, 0.5, 0); setR(fn, 0.5, 0);
        rafId = requestAnimationFrame(frame);
    } catch (err) {
        console.warn('transition error:', err);
        cleanup();
    }
}

// ============================================================
// 14. Слияние
// ============================================================
function mergeFeatures(features) {
    if (!features || !features.length) return null;
    if (features.length === 1) return features[0];
    return unionArray(features);
}

function invalidateCache() { mergedCache.ru = null; mergedCache.ua = null; mergedCache.buffer = null; }
function getMerged(mode) {
    if (mergedCache[mode]) return mergedCache[mode];
    const polys = history.filter(h => h.mode === mode).map(h => h.feature);
    mergedCache[mode] = mergeFeatures(polys);
    return mergedCache[mode];
}

// ============================================================
// 15. Отрисовка — ua → ru → buffer, буфер полупрозрачный
// ============================================================
function zoneStyle(mode, forWave) {
    const c = COLORS[mode];
    return {
        className: 'zone-path',
        color: mode === 'buffer' ? '#ffffff' : c.stroke,
        fillColor: c.fill,
        fillOpacity: mode === 'buffer' ? 0.55 : (mode === 'ru' ? 0.62 : 0.5),
        weight: (forWave && mode !== 'buffer') ? 0 : (mode === 'buffer' ? 1.6 : (mode === 'ua' ? 1 : 1.8)),
        opacity: mode === 'buffer' ? 0.85 : (mode === 'ua' ? 0.55 : 0.95),
        dashArray: null,
        lineCap: 'round',
        lineJoin: 'round'
    };
}

function redrawAll() {
    drawnItems.clearLayers();
    ['ua', 'ru', 'buffer'].forEach(mode => {
        const merged = getMerged(mode);
        if (!merged) return;
        const c = COLORS[mode];
        try {
            const layer = L.geoJSON(merged, {
                style: zoneStyle(mode, false),
                interactive: false
            });
            layer.eachLayer(sub => {
                if (sub._path) sub._path.setAttribute('data-mode', mode);
                sub._mode = mode;
            });
            layer.addTo(drawnItems);
        } catch (err) {}
    });
}

function setupZoneHovers() {
    setTimeout(() => {
        document.querySelectorAll('.leaflet-overlay-pane svg path.zone-path').forEach(p => {
            if (p._hoverSetup) return;
            p._hoverSetup = true;
            p.style.pointerEvents = 'stroke';
            p.style.cursor = 'help';
        });
    }, 100);
}

// ============================================================
// 16. UI
// ============================================================
function setMode(mode) {
    if (mode !== 'ru' && mode !== 'ua') return;
    currentMode = mode;
    ['ru', 'ua'].forEach(m => {
        const btn = document.getElementById('btn-' + m);
        if (btn) btn.classList.toggle('active', m === mode);
    });
    const lbl = document.getElementById('current-mode-label');
    if (lbl) lbl.textContent = t(mode);
    const dot = document.getElementById('mode-dot');
    if (dot) {
        dot.style.background = COLORS[mode].fill;
        dot.style.boxShadow = `0 0 8px ${COLORS[mode].glow}`;
    }
}

function resetHistory() {
    ++animGeneration;
    clearAllTempLayers();
    snapshotLayer.clearLayers();
    history = baseHistory.slice();
    undoStack = [];
    captureLog = [];
    invalidateCache();
    redrawAll();
    setupZoneHovers();
    updateStats(false);
}

function undo() {
    ++animGeneration;
    clearAllTempLayers();
    snapshotLayer.clearLayers();
    const s = undoStack.pop();
    if (!s) { showToast(t('toasts.nothingToUndo')); return; }
    // возвращаем полный снимок — вместе с вырезанным фронтом и буфером
    history = s.history;
    captureLog = s.log;
    invalidateCache();
    redrawAll();
    setupZoneHovers();
    updateStats(false);
    showToast('↩️ ' + t('toasts.undone'));
}

function clearAll() { resetHistory(); showToast('🗑 ' + t('toasts.cleared')); }
function resetToFront() { resetHistory(); showToast('🔄 ' + t('toasts.reset')); }

function saveState() {
    try {
        localStorage.setItem('frontmap_state_v2', JSON.stringify(captureLog));
        showToast('💾 ' + t('toasts.saved'));
    } catch (e) { showToast('⚠️ ' + t('toasts.saveErr')); }
}

function loadState() {
    try {
        const raw = localStorage.getItem('frontmap_state_v2');
        if (!raw) { showToast(t('toasts.noSave')); return; }
        const saved = JSON.parse(raw);
        ++animGeneration;
        clearAllTempLayers();
        snapshotLayer.clearLayers();
        history = baseHistory.slice();
        undoStack = [];
        captureLog = [];
        for (const e of saved) {              // повторяем ходы по порядку
            undoStack.push({ history: history, log: captureLog });
            history = applyCapture(history, e.mode, e.features).history;
            captureLog = captureLog.concat([e]);
        }
        invalidateCache();
        redrawAll();
        setupZoneHovers();
        updateStats(false);
        showToast('📂 ' + t('toasts.loaded'));
    } catch (e) { showToast('⚠️ ' + t('toasts.loadErr')); }
}

function updateStats(animate = true) {
    const counts = { ru: 0, ua: 0, buffer: 0 };
    const areas  = { ru: 0, ua: 0, buffer: 0 };
    ['ru', 'ua', 'buffer'].forEach(mode => {
        const polys = history.filter(h => h.mode === mode).map(h => h.feature);
        counts[mode] = polys.length;
        const merged = getMerged(mode);
        if (merged) { try { areas[mode] = Math.round(turf.area(merged) / 1e6); } catch(e) {} }
    });

    const dur = animate ? 700 : 0;
    const elStatRu = document.getElementById('stat-ru');
    const elStatUa = document.getElementById('stat-ua');
    const elStatBuf = document.getElementById('stat-buffer');
    const elAreaRu = document.getElementById('area-ru');
    const elAreaUa = document.getElementById('area-ua');
    const elAreaBuf = document.getElementById('area-buffer');

    if (animate) {
        if (parseInt(elStatRu.textContent) !== counts.ru) bumpElement(elStatRu.parentElement);
        if (parseInt(elStatUa.textContent) !== counts.ua) bumpElement(elStatUa.parentElement);
        if (parseInt(elStatBuf.textContent) !== counts.buffer) bumpElement(elStatBuf.parentElement);
    }

    animateValue(elStatRu, counts.ru, dur);
    animateValue(elStatUa, counts.ua, dur);
    animateValue(elStatBuf, counts.buffer, dur);
    animateValue(elAreaRu, areas.ru, dur);
    animateValue(elAreaUa, areas.ua, dur);
    animateValue(elAreaBuf, areas.buffer, dur);
}

// ============================================================
// 17. Клавиши
// ============================================================
document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.ctrlKey || e.metaKey) {
        if (['z','Z','я','Я'].includes(e.key)) { e.preventDefault(); undo(); }
        else if (['s','S','ы','Ы'].includes(e.key)) { e.preventDefault(); saveState(); }
        else if (['o','O','щ','Щ'].includes(e.key)) { e.preventDefault(); loadState(); }
        return;
    }
    if (e.key === '1') setMode('ru');
    else if (e.key === '2') setMode('ua');
});

// ============================================================
// 18. Старт
// ============================================================
try {
    const savedLang = localStorage.getItem('frontmap_lang');
    if (savedLang && i18n[savedLang]) currentLang = savedLang;
} catch(e) {}

document.getElementById('sound-toggle').classList.toggle('on', soundEnabled);
document.getElementById('sound-toggle').textContent = soundEnabled ? '🔊' : '🔇';

setLang(currentLang);
setMode('ru');
updateStats(false);

window.setMode = setMode;
window.setLang = setLang;
window.undo = undo;
window.clearAll = clearAll;
window.resetToFront = resetToFront;
window.saveState = saveState;
window.loadState = loadState;
window.toggleSound = toggleSound;
</script>

