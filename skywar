// ============================================================
// ЛОГИКА построения фронта
//  • RU  = оккупированная территория из DeepState — КАК ЕСТЬ (Крым, ДНР, ЛНР, Запорожье,
//          Херсонщина и всё остальное). Линия фронта не изменяется.
//  • UA  = Украина \ RU, затем убираем «зелёные» ошмётки: узкие полоски и островки,
//          которые возникают из-за разницы детализации границ (побережье, щели)
//  • BUFFER = полоса РОВНО 2 км вдоль фронта, на стороне Украины, вплотную к RU
//  • UA уменьшается на буфер → зоны не пересекаются, площадь не дублируется
// ============================================================
function pointIn(feature, lng, lat) {
    try { return turf.booleanPointInPolygon([lng, lat], feature); } catch (e) { return false; }
}

// Запасной контур Крыма (с небольшим запасом) — применяется, только если в данных DeepState Крыма нет
function crimeaFallback() {
    const ring = [[32.42,45.36],[32.50,45.66],[32.95,45.80],[33.30,46.00],[33.60,46.18],[34.30,46.20],[34.85,46.15],
        [35.10,45.95],[35.55,45.50],[36.00,45.42],[36.40,45.52],[36.70,45.40],[36.65,45.15],[36.45,45.00],[35.40,44.92],
        [35.00,44.76],[34.50,44.60],[34.20,44.40],[33.75,44.30],[33.45,44.42],[33.35,44.55],[33.30,44.75],[33.35,45.05],
        [33.00,45.15],[32.55,45.28],[32.42,45.36]];
    return turf.polygon([ring]);
}

function buildFront(ukrRaw, fine, dsFeatures) {
    const t0 = performance.now();
    const ukr = simplifySafe(ukrRaw);

    // 1) RU — данные DeepState без изменений (только лёгкое упрощение)
    const polys = [];
    dsFeatures.forEach(f => {
        const g = f && (f.geometry || f);
        if (!g || (g.type !== 'Polygon' && g.type !== 'MultiPolygon')) return;
        polys.push(f.geometry ? f : turf.feature(g));
    });
    if (!polys.length) return null;
    let ru = polys.length === 1 ? simplifySafe(polys[0]) : unionArray(polys.map(simplifySafe));
    if (!ru) return null;
    try { if (turf.area(ru) < 1e9) { console.warn('RU слишком мал'); return null; } } catch (e) {}
    console.log('1️⃣ RU из DeepState');

    // Крым должен быть оккупирован: если в данных его нет — добавляем запасной контур
    if (!pointIn(ru, 34.10, 44.95) && !pointIn(ru, 33.52, 44.60)) {
        const cr = safeBuffer(crimeaFallback(), 3) || crimeaFallback();
        ru = unionArray([ru, cr]) || ru;
        console.warn('⚠️ Крыма не было в данных — добавлен запасной контур');
    }

    // 2) UA = Украина \ RU
    let ua = differenceRobust(ukr, ru) || ukr;
    console.log('2️⃣ UA = Украина \\ RU');

    // 3) чистим «зелёные» ошмётки (открытие с восстановлением углов): тонкие полоски шире 2r уходят,
    //    крупная территория и линия фронта сохраняются
    const r = fine ? 3 : 6;
    try {
        const shrunk = safeBuffer(ua, -r);
        const zone = shrunk ? safeBuffer(shrunk, r * 1.5) : null;
        if (zone) {
            const cleaned = intersectRobust(ua, zone);
            if (cleaned) ua = cleaned;
        }
    } catch (e) { console.warn('очистка полосок:', e); }
    ua = filterSmallParts(ua, MIN_UA_PART_KM2) || ua;
    console.log('3️⃣ ошмётки UA убраны');

    // 4) буфер ровно 2 км — на стороне Украины, вплотную к RU
    let strip = null;
    try {
        const ruB = safeBuffer(ru, BUFFER_WIDTH_KM);
        if (ruB) {
            strip = intersectRobust(ruB, ua);
            strip = filterSmallParts(strip, 0.2);
        }
    } catch (e) { console.warn('буфер:', e); }
    if (strip) {
        ua = subtractFeature(ua, strip) || ua;
        console.log('4️⃣ Буфер', BUFFER_WIDTH_KM, 'км:', Math.round(turf.area(strip) / 1e6), 'км²');
    } else console.warn('Буфер не построился');

    // «вся Украина» — для обрезки рисования
    let omega = null;
    try { omega = unionArray([ukr, ru]); } catch (e) {}

    console.log('✅ расчёт:', Math.round(performance.now() - t0), 'мс');
    return { ua, ru, strip, omega };
}

// Запасной вариант: без очистки и буфера — главное, чтобы фронт был виден
function buildFrontSimple(ukrRaw, dsFeatures) {
    const polys = dsFeatures.filter(f => f && f.geometry && /Polygon/.test(f.geometry.type));
    const ru = polys.length === 1 ? polys[0] : unionArray(polys);
    if (!ru) return null;
    const ua = ukrRaw ? (differenceRobust(ukrRaw, ru) || ukrRaw) : null;
    return { ua, ru, strip: null, omega: null };
}

Promise.all([ukrPromise, dsPromise])
    .then(async ([ukr, dsFeatures]) => {
        if (!dsFeatures || !dsFeatures.length) { showToast('⚠️ ' + t('toasts.frontErr') + ' (DeepState)'); return; }
        if (!ukr) showToast('⚠️ ' + t('toasts.ukrBaseErr'));

        setLoadingText('Расчёт зон и буфера 2 км…');
        await tick();

        let res = null;
        if (ukr) {
            try { res = buildFront(ukr.feature, ukr.fine, dsFeatures); }
            catch (e) { console.warn('buildFront error:', e); }
        }
        if (!res) {
            console.warn('Основной расчёт не удался — запасной вариант');
            try { res = buildFrontSimple(ukr ? ukr.feature : null, dsFeatures); } catch (e) { console.warn('simple error:', e); }
        }
        if (!res) { showToast('⚠️ ' + t('toasts.frontErr')); return; }

        UKR_FEATURE = res.omega || null;
        history = [];
        if (res.ua) history.push({ mode: 'ua', feature: res.ua, source: 'base' });
        history.push({ mode: 'ru', feature: res.ru, source: 'deepstate' });
        if (res.strip) history.push({ mode: 'buffer', feature: res.strip, source: 'auto-border' });
        baseHistory = history.slice();
        undoStack = []; captureLog = [];

        invalidateCache();
        redrawAll();
        setupZoneHovers();
        updateStats(false);

        const d = dsDate(dsFeatures.sourceName);
        const dateTxt = d !== '00000000' ? ` · ${d.slice(6)}.${d.slice(4, 6)}.${d.slice(0, 4)}` : '';
        showToast('✅ ' + t('toasts.frontLoaded') + dateTxt + (res.strip ? '' : ' (без буфера)'));
    })
    .catch(err => {
        console.warn('Ошибка загрузки:', err);
        showToast('⚠️ ' + t('toasts.frontErr'));
    })
    .finally(() => hideLoading());

// ============================================================
// 8. Мышь
// ============================================================
let rightDrag = null, isDrawing = false, drawPoints = [], drawPreview = null;
const mapContainer = map.getContainer();

mapContainer.addEventListener('mousedown', (e) => {
    if (e.button === 2) {
        e.preventDefault();
        rightDrag = { startX: e.clientX, startY: e.clientY, center: map.getCenter(), zoom: map.getZoom() };
        mapContainer.classList.add('panning');
    }
});

window.addEventListener('mousemove', (e) => {
    if (!rightDrag) return;
    const dx = e.clientX - rightDrag.startX;
    const dy = e.clientY - rightDrag.startY;
    const sp = map.project(rightDrag.center, rightDrag.zoom);
    map.setView(map.unproject(L.point(sp.x - dx, sp.y - dy), rightDrag.zoom), rightDrag.zoom, { animate: false });
});

window.addEventListener('mouseup', (e) => {
    if (e.button === 2 && rightDrag) { rightDrag = null; mapContainer.classList.remove('panning'); }
});

mapContainer.addEventListener('contextmenu', (e) => e.preventDefault());

map.on('mousedown', (e) => {
    if (e.originalEvent.button !== 0 || rightDrag) return;
    isDrawing = true;
    drawPoints = [e.latlng];
    const c = COLORS[currentMode];
    drawPreview = L.polygon([e.latlng, e.latlng], {
        color: c.stroke, fillColor: c.fill, fillOpacity: 0.35, weight: 3, dashArray: '8, 5', interactive: false
    }).addTo(map);
    mapContainer.classList.add('drawing');
});

map.on('mousemove', (e) => {
    if (!isDrawing) return;
    drawPoints.push(e.latlng);
    if (drawPreview) drawPreview.setLatLngs(drawPoints);
});

map.on('mouseup', (e) => {
    if (e.originalEvent.button !== 0 || !isDrawing) return;
    isDrawing = false;
    mapContainer.classList.remove('drawing');
    if (drawPreview) { map.removeLayer(drawPreview); drawPreview = null; }
    if (drawPoints.length < 3) { drawPoints = []; showToast(t('toasts.tooFewPoints')); return; }

    const coords = drawPoints.map(ll => [ll.lng, ll.lat]);
    const first = coords[0], last = coords[coords.length - 1];
    if (first[0] !== last[0] || first[1] !== last[1]) coords.push(first);
    drawPoints = [];

    let feature;
    try {
        feature = turf.polygon([coords]);
        if (turf.area(feature) < 100000) { showToast(t('toasts.tooSmall')); return; }
    } catch (err) { showToast(t('toasts.selfIntersect')); return; }

    let finalFeature = cleanPolygon(feature);
    // рисовать можно только в пределах Украины — иначе зоны «вылезают» в Россию, Польшу и море
    if (UKR_FEATURE) {
        const clipped = intersectRobust(finalFeature, UKR_FEATURE);
        if (!clipped || turf.area(clipped) < 100000) { showToast(t('toasts.outside')); return; }
        finalFeature = clipped;
    }
    addCaptureBatch(currentMode, [finalFeature]);
});

function cleanPolygon(feature) {
    let pieces = null;
    try {
        const unkinked = turf.unkinkPolygon(feature);
        if (unkinked && unkinked.features && unkinked.features.length) pieces = unkinked.features;
    } catch (e) {}
    if (!pieces || pieces.length === 0) return feature;
    if (pieces.length === 1) return pieces[0];
    return unionArray(pieces) || pieces[0];
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isDrawing) {
        isDrawing = false;
        if (drawPreview) { map.removeLayer(drawPreview); drawPreview = null; }
        drawPoints = [];
        mapContainer.classList.remove('drawing');
        showToast(t('toasts.cancel'));
    }
});

