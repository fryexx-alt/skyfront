<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Front Map — рисование зон контроля</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    * { user-select: none; -webkit-user-select: none; box-sizing: border-box; }
    html, body { margin: 0; padding: 0; font-family: 'Inter', 'Segoe UI', Arial, sans-serif; background: #05070a; overflow: hidden; height: 100%; color: #e8e8e8; }
    #map { width: 100vw; height: 100vh; cursor: crosshair; position: relative; }
    #map.panning { cursor: grabbing !important; }
    #map.drawing { cursor: crosshair !important; }
    #map::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 0%, transparent 60%, rgba(0,0,0,0.38) 100%); z-index: 500; }

    .leaflet-overlay-pane svg path.zone-path { transition: filter 0.3s ease; }
    .leaflet-overlay-pane svg path.zone-path[data-mode="ru"] { filter: drop-shadow(0 0 4px rgba(198, 40, 40, 0.85)); }
    .leaflet-overlay-pane svg path.zone-path[data-mode="ua"] { filter: drop-shadow(0 0 3px rgba(76, 175, 80, 0.4)); }
    .leaflet-overlay-pane svg path.zone-path[data-mode="buffer"] { filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.3)); }


    .leaflet-snapshotPane-pane svg path[data-mode="ru"] { filter: drop-shadow(0 0 4px rgba(198, 40, 40, 0.85)); }
    .leaflet-snapshotPane-pane svg path[data-mode="ua"] { filter: drop-shadow(0 0 3px rgba(76, 175, 80, 0.4)); }
    .leaflet-snapshotPane-pane svg path[data-mode="buffer"] { filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.3)); }

    .ripple { position: absolute; width: 20px; height: 20px; border: 3px solid #fff; border-radius: 50%; transform: translate(-50%, -50%) scale(0.2); pointer-events: none; opacity: 0.9; animation: rippleOut 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards; z-index: 550; }
    @keyframes rippleOut { 0% { transform: translate(-50%, -50%) scale(0.2); opacity: 0.9; border-width: 3px; } 60% { opacity: 0.5; } 100% { transform: translate(-50%, -50%) scale(14); opacity: 0; border-width: 1px; } }

    .float-area { position: absolute; transform: translate(-50%, -50%); font-weight: 800; font-size: 18px; letter-spacing: 0.5px; text-shadow: 0 2px 8px rgba(0,0,0,0.9), 0 0 16px currentColor; pointer-events: none; animation: floatUp 2.2s cubic-bezier(0.22, 1, 0.36, 1) forwards; z-index: 560; white-space: nowrap; }
    @keyframes floatUp { 0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; } 20% { transform: translate(-50%, -80%) scale(1.1); opacity: 1; } 100% { transform: translate(-50%, -220%) scale(1); opacity: 0; } }

    .panel { position: absolute; top: 16px; left: 16px; z-index: 1000; background: linear-gradient(145deg, rgba(24, 28, 36, 0.92), rgba(14, 17, 22, 0.96)); backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%); padding: 16px; border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.06) inset, 0 1px 0 rgba(255,255,255,0.08) inset; display: flex; flex-direction: column; gap: 8px; min-width: 250px; border: 1px solid rgba(255,255,255,0.06); transition: transform 0.3s ease; }
    .panel:hover { transform: translateY(-2px); }
    .panel-header { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .logo { width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg, #c62828 0%, #2e7d32 100%); display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 4px 12px rgba(198, 40, 40, 0.4), 0 0 0 1px rgba(255,255,255,0.1) inset; flex-shrink: 0; animation: logoPulse 3s ease-in-out infinite; }
    @keyframes logoPulse { 0%, 100% { transform: rotate(0deg) scale(1); } 50% { transform: rotate(-8deg) scale(1.05); } }
    .panel-title-block { flex: 1; min-width: 0; }
    .panel-title { font-size: 15px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #fff; background: linear-gradient(90deg, #fff 0%, #b8b8b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .panel-subtitle { font-size: 10px; color: #6b7280; letter-spacing: 0.5px; margin-top: -2px; }

    .header-controls { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }
    .lang-switch { display: flex; background: rgba(0,0,0,0.4); border-radius: 8px; padding: 2px; border: 1px solid rgba(255,255,255,0.06); }
    .lang-btn { background: transparent; border: none; color: #6b7280; font-family: inherit; font-size: 11px; font-weight: 700; padding: 5px 8px; border-radius: 6px; cursor: pointer; transition: all 0.2s ease; letter-spacing: 0.5px; text-transform: uppercase; }
    .lang-btn:hover { color: #fff; }
    .lang-btn.active { background: linear-gradient(135deg, rgba(255,214,0,0.2), rgba(255,150,0,0.15)); color: #ffd600; box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,214,0,0.3) inset; }
    .sound-toggle { width: 28px; height: 28px; border-radius: 7px; border: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.4); color: #6b7280; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 14px; transition: all 0.2s ease; }
    .sound-toggle:hover { color: #fff; border-color: rgba(255,255,255,0.15); }
    .sound-toggle.on { color: #ffd600; box-shadow: 0 0 0 1px rgba(255,214,0,0.4) inset; }

    .current-mode { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12px; padding: 8px 12px; margin-bottom: 4px; color: #aaa; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.04); }
    .current-mode strong { color: #fff; font-weight: 700; }
    .mode-dot { width: 8px; height: 8px; border-radius: 50%; transition: background 0.3s, box-shadow 0.3s; animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.55; transform: scale(1.15); } }

    .btn { padding: 10px 14px; border: none; border-radius: 9px; cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit; transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1); color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 8px; position: relative; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.35), 0 1px 0 rgba(255,255,255,0.12) inset; letter-spacing: 0.2px; }
    .btn::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0)); pointer-events: none; }
    .btn::after { content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent); transform: skewX(-25deg); transition: left 0.6s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: none; }
    .btn:hover::after { left: 130%; }
    .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.15) inset; }
    .btn:active { transform: translateY(0) scale(0.98); }
    .btn .kbd-hint { font-size: 10px; opacity: 0.55; background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px; font-family: 'SF Mono', Consolas, monospace; }
    .btn-ru { background: linear-gradient(135deg, #c62828 0%, #8e0000 100%); }
    .btn-ua { background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%); }
    .btn-undo { background: linear-gradient(135deg, #6a1b9a 0%, #4a148c 100%); }
    .btn-clear { background: linear-gradient(135deg, #424242 0%, #212121 100%); }
    .btn-save { background: linear-gradient(135deg, #00897b 0%, #004d40 100%); }
    .btn-load { background: linear-gradient(135deg, #ef6c00 0%, #bf360c 100%); }
    .btn-reset { background: linear-gradient(135deg, #b71c1c 0%, #7f0000 100%); }
    .btn.active { box-shadow: 0 0 0 2px #ffd600, 0 0 20px rgba(255, 214, 0, 0.4), 0 6px 16px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.15) inset; transform: translateY(-1px); }
    .btn.active::after { content: ''; position: absolute; top: 6px; right: 6px; width: 6px; height: 6px; background: #ffd600; border-radius: 50%; box-shadow: 0 0 8px #ffd600; animation: pulse 1.5s ease-in-out infinite; }
    .row { display: flex; gap: 6px; }
    .row .btn { flex: 1; padding: 9px 8px; font-size: 12px; }
    .row .btn .kbd-hint { display: none; }

    .stats { margin-top: 8px; padding: 12px; border-radius: 9px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.04); color: #bbb; font-size: 12px; line-height: 1.7; }
    .stats-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #6b7280; margin-bottom: 8px; }
    .stat-row { display: flex; align-items: center; justify-content: space-between; padding: 3px 0; font-variant-numeric: tabular-nums; }
    .stat-row .stat-label { display: flex; align-items: center; gap: 6px; color: #ccc; font-weight: 500; }
    .stat-row .stat-value { font-weight: 700; color: #fff; font-size: 12px; transition: color 0.3s, text-shadow 0.3s; }
    .stat-row .stat-value.bump { color: #ffd600; text-shadow: 0 0 12px rgba(255, 214, 0, 0.8); }
    .stat-row .stat-unit { color: #6b7280; font-weight: 500; font-size: 11px; }
    .stat-dot { width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 6px currentColor; }

    .hint { margin-top: 8px; padding: 10px; border-radius: 8px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); font-size: 10.5px; color: #6b7280; line-height: 1.7; }
    .hint kbd { background: rgba(255,255,255,0.08); padding: 2px 5px; border-radius: 4px; font-family: 'SF Mono', Consolas, monospace; font-size: 9.5px; color: #d1d5db; border: 1px solid rgba(255,255,255,0.06); }
    .hint .badge-auto { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px; margin-top: 6px; background: linear-gradient(135deg, rgba(224,224,224,0.25), rgba(158,158,158,0.15)); border: 1px solid rgba(224,224,224,0.4); border-radius: 5px; color: #e0e0e0; font-size: 10px; font-weight: 600; }

    .legend { position: absolute; bottom: 20px; left: 16px; z-index: 1000; background: linear-gradient(145deg, rgba(24, 28, 36, 0.92), rgba(14, 17, 22, 0.96)); backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%); padding: 12px 16px; border-radius: 12px; font-size: 12px; color: #eee; box-shadow: 0 8px 24px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06) inset; border: 1px solid rgba(255,255,255,0.06); }
    .legend-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #6b7280; margin-bottom: 6px; }
    .legend-item { display: flex; align-items: center; gap: 8px; margin: 5px 0; font-weight: 500; }
    .color-box { width: 16px; height: 16px; border-radius: 5px; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 2px 6px rgba(0,0,0,0.4), 0 1px 0 rgba(255,255,255,0.15) inset; flex-shrink: 0; position: relative; overflow: hidden; }
    .color-box::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.5) 50%, transparent 70%); animation: shimmer 2.4s linear infinite; }
    @keyframes shimmer { 0% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }

    .compass { position: absolute; bottom: 20px; right: 20px; z-index: 1000; width: 76px; height: 76px; pointer-events: none; opacity: 0.85; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.7)); }
    .compass .ring { fill: rgba(20, 24, 32, 0.85); stroke: rgba(255, 214, 0, 0.4); stroke-width: 1; }
    .compass .tick { stroke: rgba(255,255,255,0.35); stroke-width: 1; }
    .compass .tick-major { stroke: rgba(255,214,0,0.85); stroke-width: 1.5; }
    .compass .needle-n { fill: #c62828; }
    .compass .needle-s { fill: #2e7d32; }
    .compass .center { fill: #fff; }
    .compass text { fill: #fff; font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 800; text-anchor: middle; }
    .compass .letter-n { fill: #ff5252; }
    .compass .letter-s { fill: #81c784; }
    .compass .needle-wrapper { animation: compassSway 6s ease-in-out infinite; transform-origin: 38px 38px; }
    @keyframes compassSway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }

    .toast { position: absolute; top: 20px; left: 50%; transform: translateX(-50%) translateY(-20px); z-index: 2000; background: linear-gradient(145deg, rgba(28, 32, 42, 0.96), rgba(18, 20, 26, 0.98)); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); color: #fff; padding: 12px 22px; border-radius: 12px; font-size: 13px; font-weight: 500; opacity: 0; transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: none; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 12px 32px rgba(0,0,0,0.6); white-space: nowrap; letter-spacing: 0.2px; }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    .loading-banner { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2001; background: linear-gradient(145deg, rgba(24, 28, 36, 0.96), rgba(14, 17, 22, 0.98)); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); color: #fff; padding: 18px 32px; border-radius: 14px; font-size: 14px; font-weight: 500; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 16px 40px rgba(0,0,0,0.7); transition: opacity 0.4s, transform 0.4s; display: flex; align-items: center; gap: 14px; }
    .loading-banner.hidden { opacity: 0; transform: translate(-50%, -50%) scale(0.9); pointer-events: none; }
    .spinner { width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.15); border-top-color: #ffd600; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .leaflet-control-zoom { border: none !important; box-shadow: 0 6px 20px rgba(0,0,0,0.55) !important; border-radius: 10px !important; overflow: hidden; margin-right: 20px !important; margin-bottom: 110px !important; }
    .leaflet-control-zoom a { background: linear-gradient(145deg, rgba(24, 28, 36, 0.96), rgba(14, 17, 22, 0.98)) !important; color: #fff !important; border: none !important; border-bottom: 1px solid rgba(255,255,255,0.06) !important; width: 34px !important; height: 34px !important; line-height: 34px !important; font-size: 18px !important; font-weight: 300 !important; }
    .leaflet-control-zoom a:hover { background: rgba(40, 46, 58, 0.96) !important; color: #ffd600 !important; }
    .leaflet-control-zoom a:last-child { border-bottom: none !important; }
    .leaflet-control-attribution { display: none; }

    @keyframes slideIn { from { opacity: 0; transform: translateX(-16px); } to { opacity: 1; transform: translateX(0); } }
    .panel { animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .legend { animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.1s both; }
</style>
</head>
<body>

<div id="map"></div>

<div class="panel">
    <div class="panel-header">
        <div class="logo">⚔️</div>
        <div class="panel-title-block">
            <div class="panel-title">Front Map</div>
            <div class="panel-subtitle" data-i18n="subtitle">Редактор зон контроля</div>
        </div>
        <div class="header-controls">
            <div class="lang-switch">
                <button class="lang-btn active" id="lang-ru" onclick="setLang('ru')">RU</button>
                <button class="lang-btn" id="lang-ua" onclick="setLang('ua')">UA</button>
            </div>
            <button class="sound-toggle on" id="sound-toggle" onclick="toggleSound()" title="Звук">🔊</button>
        </div>
    </div>

    <div class="current-mode">
        <span class="mode-dot" id="mode-dot" style="background:#c62828; box-shadow:0 0 8px #c62828;"></span>
        <span data-i18n="mode">Режим:</span> <strong id="current-mode-label" data-i18n="ru">Россия</strong>
    </div>

    <button class="btn btn-ru active" id="btn-ru" onclick="setMode('ru')">
        <span>🔴 <span data-i18n="ru">Россия</span></span>
        <span class="kbd-hint">1</span>
    </button>
    <button class="btn btn-ua" id="btn-ua" onclick="setMode('ua')">
        <span>🟢 <span data-i18n="ua">Украина</span></span>
        <span class="kbd-hint">2</span>
    </button>

    <div class="row">
        <button class="btn btn-undo" onclick="undo()">↩️ <span data-i18n="undo">Отмена</span></button>
        <button class="btn btn-clear" onclick="clearAll()">🗑 <span data-i18n="clear">Очистить</span></button>
    </div>
    <div class="row">
        <button class="btn btn-save" onclick="saveState()">💾 <span data-i18n="save">Сохранить</span></button>
        <button class="btn btn-load" onclick="loadState()">📂 <span data-i18n="load">Загрузить</span></button>
    </div>
    <button class="btn btn-reset" onclick="resetToFront()">🔄 <span data-i18n="reset">Сбросить к фронту</span></button>

    <div class="stats">
        <div class="stats-title" data-i18n="stats">Статистика</div>
        <div class="stat-row">
            <span class="stat-label"><span class="stat-dot" style="background:#c62828; color:#c62828;"></span><span data-i18n="ru">Россия</span></span>
            <span class="stat-value"><span id="stat-ru">0</span> <span data-i18n="zones">зон</span> · <span id="area-ru">0</span> <span class="stat-unit">км²</span></span>
        </div>
        <div class="stat-row">
            <span class="stat-label"><span class="stat-dot" style="background:#2e7d32; color:#2e7d32;"></span><span data-i18n="ua">Украина</span></span>
            <span class="stat-value"><span id="stat-ua">0</span> <span data-i18n="zones">зон</span> · <span id="area-ua">0</span> <span class="stat-unit">км²</span></span>
        </div>
        <div class="stat-row">
            <span class="stat-label"><span class="stat-dot" style="background:#e0e0e0; color:#e0e0e0;"></span><span data-i18n="bufferShort">Буфер</span></span>
            <span class="stat-value"><span id="stat-buffer">0</span> <span data-i18n="zones">зон</span> · <span id="area-buffer">0</span> <span class="stat-unit">км²</span></span>
        </div>
    </div>

    <div class="hint" id="hint-block"></div>
</div>

<div class="legend">
    <div class="legend-title" data-i18n="legend">Легенда</div>
    <div class="legend-item"><div class="color-box" style="background:linear-gradient(135deg,#c62828,#8e0000);"></div> <span data-i18n="legendRu">Контроль России</span></div>
    <div class="legend-item"><div class="color-box" style="background:linear-gradient(135deg,#2e7d32,#1b5e20);"></div> <span data-i18n="legendUa">Контроль Украины</span></div>
    <div class="legend-item"><div class="color-box" style="background:linear-gradient(135deg,rgba(230,230,230,0.45),rgba(180,180,180,0.45));"></div> <span data-i18n="legendBuffer">Буферная зона</span></div>
</div>

<svg class="compass" viewBox="0 0 76 76" xmlns="http://www.w3.org/2000/svg">
    <circle class="ring" cx="38" cy="38" r="34"/>
    <line class="tick-major" x1="38" y1="4"  x2="38" y2="10"/>
    <line class="tick-major" x1="38" y1="66" x2="38" y2="72"/>
    <line class="tick-major" x1="4"  y1="38" x2="10" y2="38"/>
    <line class="tick-major" x1="66" y1="38" x2="72" y2="38"/>
    <line class="tick" x1="55" y1="9"  x2="52" y2="14"/>
    <line class="tick" x1="67" y1="21" x2="62" y2="24"/>
    <line class="tick" x1="67" y1="55" x2="62" y2="52"/>
    <line class="tick" x1="55" y1="67" x2="52" y2="62"/>
    <line class="tick" x1="21" y1="67" x2="24" y2="62"/>
    <line class="tick" x1="9"  y1="55" x2="14" y2="52"/>
    <line class="tick" x1="9"  y1="21" x2="14" y2="24"/>
    <line class="tick" x1="21" y1="9"  x2="24" y2="14"/>
    <g class="needle-wrapper">
        <polygon class="needle-n" points="38,12 34,38 42,38"/>
        <polygon class="needle-s" points="38,64 34,38 42,38"/>
    </g>
    <circle class="center" cx="38" cy="38" r="2"/>
    <text class="letter-n" x="38" y="20">N</text>
    <text class="letter-s" x="38" y="60">S</text>
</svg>

<div class="toast" id="toast"></div>
<div class="loading-banner" id="loading-banner">
    <div class="spinner"></div>
    <span data-i18n="loading">Загрузка актуального фронта…</span>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/@turf/turf@6/turf.min.js"></script>

<script>
// ============================================================
// 1. i18n
// ============================================================
const i18n = {
    ru: {
        subtitle: 'Редактор зон контроля', mode: 'Режим:', ru: 'Россия', ua: 'Украина',
        buffer: 'Буферная зона', bufferShort: 'Буфер', undo: 'Отмена', clear: 'Очистить',
        save: 'Сохранить', load: 'Загрузить', reset: 'Сбросить к фронту',
        stats: 'Статистика', zones: 'зон', legend: 'Легенда',
