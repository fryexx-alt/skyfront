function splitToPolygons(feature) {
    if (!feature) return [];
    try {
        const geom = feature.geometry || feature;
        if (!geom) return [];
        if (geom.type === 'Polygon') return [turf.polygon(geom.coordinates)];
        if (geom.type === 'MultiPolygon') return geom.coordinates.map(c => turf.polygon(c));
        if (geom.type === 'FeatureCollection') {
            const result = [];
            (geom.features || []).forEach(f => {
                splitToPolygons(f).forEach(p => result.push(p));
            });
            return result;
        }
        return [feature];
    } catch(e) { return []; }
}

function unionArray(features) {
    let layer = (features || []).filter(f => f);
    if (!layer.length) return null;
    // турф v6: union(a, b) — сливаем попарно «деревом», это быстрее цепочки
    while (layer.length > 1) {
        const next = [];
        for (let i = 0; i < layer.length; i += 2) {
            if (i + 1 >= layer.length) { next.push(layer[i]); break; }
            let u = null;
            try { u = turf.union(layer[i], layer[i + 1]); } catch (e) {}
            if (u) next.push(u); else { next.push(layer[i]); next.push(layer[i + 1]); }
        }
        if (next.length >= layer.length) {
            // ничего не слилось — собираем как MultiPolygon, чтобы не зациклиться
            const coords = [];
            layer.forEach(f => splitToPolygons(f).forEach(p => {
                if (p.geometry && p.geometry.type === 'Polygon') coords.push(p.geometry.coordinates);
            }));
            return coords.length ? turf.multiPolygon(coords) : layer[0];
        }
        layer = next;
    }
    return layer[0];
}

function intersectRobust(a, b) {
    if (!a || !b) return null;
    try {
        const direct = turf.intersect(a, b);
        if (direct) return direct;
    } catch(e) {}
    const aParts = splitToPolygons(a);
    const bParts = splitToPolygons(b);
    const results = [];
    for (const ap of aParts) {
        for (const bp of bParts) {
            try {
                const inter = turf.intersect(ap, bp);
                if (inter && turf.area(inter) > 1000) results.push(inter);
            } catch(e) {}
        }
    }
    return unionArray(results);
}

function differenceRobust(a, b) {
    if (!a || !b) return a;
    try {
        const direct = turf.difference(a, b);
        if (direct !== undefined) return direct;
    } catch(e) {}
    const aParts = splitToPolygons(a);
    const bParts = splitToPolygons(b);
    const results = [];
    for (const ap of aParts) {
        let remainder = ap;
        for (const bp of bParts) {
            if (!remainder) break;
            try {
                remainder = turf.difference(remainder, bp);
            } catch(e) {}
        }
        if (remainder && turf.area(remainder) > 1000) results.push(remainder);
    }
    return unionArray(results);
}

function safeBuffer(f, km) {
    if (!f) return null;
    try { return turf.buffer(f, km, { units: 'kilometers', steps: 6 }) || null; }
    catch(e) { return null; }
}

function simplifySafe(f) {
    try { return turf.simplify(f, { tolerance: SIMPLIFY_TOL, highQuality: false, mutate: false }) || f; }
    catch (e) { return f; }
}

// вычесть cutter из feat; null — если ничего не осталось
function subtractFeature(feat, cutter) {
    if (!feat) return null;
    if (!cutter) return feat;
    const diff = differenceRobust(feat, cutter);
    if (!diff) return null;
    try { if (turf.area(diff) < 1000) return null; } catch (e) {}
    return diff;
}

function paddedBox(feature, padDeg) {
    const b = turf.bbox(feature);
    return turf.bboxPolygon([b[0] - padDeg, b[1] - padDeg, b[2] + padDeg, b[3] + padDeg]);
}

function filterSmallParts(feature, minAreaKm2) {
    if (!feature) return feature;
    try {
        const minAreaM2 = minAreaKm2 * 1e6;
        const parts = splitToPolygons(feature);
        const kept = parts.filter(p => {
            try { return turf.area(p) >= minAreaM2; } catch(e) { return false; }
        });
        if (kept.length === 0) return null;
        if (kept.length === 1) return kept[0];
        return unionArray(kept);
    } catch(e) { return feature; }
}

