function ymd(d) {
    return d.getUTCFullYear() + String(d.getUTCMonth() + 1).padStart(2, '0') + String(d.getUTCDate()).padStart(2, '0');
}
function dsDate(name) {
    const m = /(\d{4})-?(\d{2})-?(\d{2})/.exec(name || '');
    return m ? m[1] + m[2] + m[3] : '00000000';
}
async function tryJson(url) {
    try { const r = await fetch(url); if (r.ok) return await r.json(); } catch (e) {}
    return null;
}

// способ 1: как в исходном файле (GitHub contents API; отдаёт максимум 1000 файлов)
async function dsViaContents() {
    const files = await tryJson('https://api.github.com/repos/' + DS_REPO + '/contents/data');
    if (!files || !files.length) return null;
    const list = files.filter(f => f.name.endsWith('.geojson')).sort((a, b) => b.name.localeCompare(a.name));
    if (!list.length) return null;
    const j = await tryJson(list[0].download_url);
    return j ? { name: list[0].name, json: j } : null;
}
// способ 2: файлы по датам (последние 10 дней) — параллельно
async function dsViaDates() {
    const now = new Date(), cands = [];
    for (let i = 0; i < 10; i++) {
        const a = ymd(new Date(now.getTime() - i * 86400000));
        const b = a.slice(0, 4) + '-' + a.slice(4, 6) + '-' + a.slice(6);
        for (const base of DS_RAW_BASES) {
            cands.push(base + 'data/deepstatemap_data_' + a + '.geojson');
            cands.push(base + 'data/deepstatemap_data_' + b + '.geojson');
        }
    }
    const got = (await Promise.all(cands.map(async u => ({ u, j: await tryJson(u) })))).filter(x => x.j);
    if (!got.length) return null;
    got.sort((x, y) => dsDate(y.u).localeCompare(dsDate(x.u)));
    return { name: got[0].u.split('/').pop(), json: got[0].j };
}
// способ 3: полные списки файлов (jsDelivr, git tree)
async function dsViaListing() {
    try {
        const r = await fetch('https://data.jsdelivr.com/v1/packages/gh/' + DS_REPO + '@main?structure=flat');
        if (r.ok) {
            const files = ((await r.json()).files || []).map(f => f.name).filter(n => /^\/data\/.*\.geojson$/.test(n)).sort();
            if (files.length) {
                const last = files[files.length - 1];
                const j = await tryJson('https://cdn.jsdelivr.net/gh/' + DS_REPO + '@main' + last);
                if (j) return { name: last.split('/').pop(), json: j };
            }
        }
    } catch (e) {}
    try {
        const r = await fetch('https://api.github.com/repos/' + DS_REPO + '/git/trees/HEAD?recursive=1');
        if (r.ok) {
            const files = ((await r.json()).tree || []).map(n => n.path).filter(p => /^data\/.*\.geojson$/.test(p)).sort();
            if (files.length) {
                const last = files[files.length - 1];
                for (const base of DS_RAW_BASES) { const j = await tryJson(base + last); if (j) return { name: last.split('/').pop(), json: j }; }
            }
        }
    } catch (e) {}
    return null;
}

